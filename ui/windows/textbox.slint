// Scrollable markdown result window.

import { Button, Slider, ScrollView, Palette } from "std-widgets.slint";
import { MarkdownBlock } from "../types/markdown.slint";

export component TextboxWindow inherits Window {
    title: "Textbox";
    icon: @image-url("../../app.ico");
    always-on-top: true;
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 600px;
    preferred-height: 200px;
    min-width: 320px;
    min-height: 100px;
    background: dark_theme ? #2b2b31 : #f8fafc;
    default-font-family: root.result_font_family;
    
    in-out property <string> text: "";
    in-out property <color> text_color: #1e293b;
    in-out property <length> font_size: 15px;
    in-out property <string> result_font_family: "Yu Gothic UI";
    in-out property <bool> dark_theme: false;
    in property <[string]> preset_options;
    in-out property <int> preset_index: -1;
    private property <length> titlebar-height: 42px;
    pure callback render-markdown(string) -> [MarkdownBlock];
    callback copy-original();
    callback font-size-changed(float);
    callback drag-requested();
    callback close-clicked();
    callback preset-selected(string);
    callback preset-menu-requested(float, float);
    private property <[MarkdownBlock]> blocks: render-markdown(text);
    private property <color> foreground: dark_theme
        ? (text_color == #1e293b || text_color == #000000 ? #f8fafc : text_color)
        : (text_color == #ffffff ? #1e293b : text_color);
    forward-focus: copy-keys;

    // ScrollView and its hover states use the standard widget palette. Keep that palette in
    // sync even while the main settings window is hidden in capture mode.
    init => {
        Palette.color-scheme = dark_theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark_theme => {
        Palette.color-scheme = dark_theme ? ColorScheme.dark : ColorScheme.light;
    }

    Rectangle {
        border-width: 1px;
        border-color: root.dark_theme ? #52525b : #cbd5e1;
    }

    copy-keys := FocusScope {
        x: 0px;
        y: root.titlebar-height;
        width: root.width;
        height: max(0px, root.height - root.titlebar-height);
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                root.copy-original();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Rectangle {
                background: dark_theme ? #37373f : #ffffff;
                border-radius: 8px;
                border-width: 1px;
                border-color: dark_theme ? #52525b : #e2e8f0;
                ScrollView {
                    // The Flickable only derives its viewport from the content's minimum
                    // height, and the block rows clamp that to 0px, so bind the viewport
                    // to the height the content actually needs; otherwise long results
                    // can't scroll and get clipped.
                    viewport-height: max(self.visible-height, content-layout.preferred-height);
                    content-layout := VerticalLayout {
                        width: parent.width;
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;
                        for block in root.blocks: Rectangle {
                            vertical-stretch: 0;
                            min-height: block.rule ? 1px : 0px;
                            background: block.rule ? (root.dark_theme ? #52525b : #cbd5e1)
                                : block.code ? (root.dark_theme ? #292930 : #f1f5f9)
                                : transparent;
                            border-radius: block.code ? 4px : 0px;
                            // The block keeps a single always-present layout child so its
                            // implicit size stays derived from the content; the table and
                            // text variants only pick what is instantiated inside.
                            VerticalLayout {
                                // A table renders as one grid so the columns are shared
                                // across rows; the 1px spacing lets the frame color show
                                // through as the table lines, and the start alignment keeps
                                // the grid at its content width instead of stretching it
                                // across the full row.
                                if block.table : HorizontalLayout {
                                    alignment: start;
                                    padding-left: block.indent * 18px;
                                    Rectangle {
                                        background: root.dark_theme ? #52525b : #cbd5e1;
                                        border-radius: 6px;
                                        clip: true;
                                        GridLayout {
                                            padding: 1px;
                                            spacing-horizontal: 1px;
                                            spacing-vertical: 1px;
                                            for table_row in block.rows: Row {
                                                for cell in table_row.cells: Rectangle {
                                                    background: cell.heading
                                                        ? (root.dark_theme ? #41414b : #f1f5f9)
                                                        : (root.dark_theme ? #37373f : #ffffff);
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        padding-top: 5px;
                                                        padding-bottom: 5px;
                                                        StyledText {
                                                            horizontal-stretch: 1;
                                                            text: cell.content;
                                                            default-font-size: root.font_size * block.font-scale;
                                                            default-font-family: root.result_font_family;
                                                            default-color: root.foreground;
                                                            vertical-alignment: top;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if !block.table : HorizontalLayout {
                                    padding: block.code ? 8px : 0px;
                                    padding-left: block.indent * 18px + (block.code ? 8px : 0px);
                                    spacing: 8px;
                                    if block.quote: Rectangle {
                                        width: 3px;
                                        background: root.dark_theme ? #94a3b8 : #64748b;
                                    }
                                    if block.prefix != "": Text {
                                        text: block.prefix;
                                        color: root.foreground;
                                        font-size: root.font_size;
                                        vertical-alignment: top;
                                    }
                                    for cell in block.cells: StyledText {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        preferred-width: 0px;
                                        text: block.heading ? @markdown("**\{cell.content}**") : cell.content;
                                        default-font-size: root.font_size * block.font-scale;
                                        default-font-family: root.result_font_family;
                                        default-color: root.foreground;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Keep the preset and font controls on one line even at the minimum window width.
    titlebar := Rectangle {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.titlebar-height;
        background: root.dark_theme ? #37373f : #e2e8f0;
        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 42px;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 4px;
            Rectangle {
                min-width: 48px;
                horizontal-stretch: 1;
                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: root.title;
                    color: root.dark_theme ? #f8fafc : #1e293b;
                    font-family: "Yu Gothic UI";
                    font-size: 12px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
                title-drag := TouchArea {
                    // Release Slint's grab before the native move loop consumes mouse-up.
                    enabled: !self.pressed;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.drag-requested();
                        }
                    }
                }
            }
            preset-control := Rectangle {
                width: 120px;
                height: 28px;
                private property <bool> available: root.preset_options.length > 0;
                private property <string> label: root.preset_index < 0 ? "Prompt preset" : root.preset_options[root.preset_index];
                preset-button := Button {
                    width: 100%;
                    height: 100%;
                    enabled: preset-control.available;
                    accessible-label: "Prompt preset";
                    accessible-value: preset-control.label;
                    // A native menu can extend beyond this short window. Button activation
                    // also supplies the same anchor when opened with Enter or Space.
                    clicked => {
                        root.preset-menu-requested(
                            (titlebar.x + preset-control.x) / 1px,
                            (titlebar.y + preset-control.y + preset-control.height) / 1px);
                    }
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: root.dark_theme ? #37373f : #ffffff;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: preset-button.has-focus ? #2588e9 : (root.dark_theme ? #52525b : #94a3b8);
                    Text {
                        x: 8px;
                        width: parent.width - 28px;
                        height: parent.height;
                        text: preset-control.label;
                        font-family: "Yu Gothic UI";
                        font-size: 12px;
                        color: root.dark_theme ? #f8fafc : #1e293b;
                        opacity: preset-control.available ? 1 : 0.38;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Image {
                        source: @image-url("../icons/chevron-down.svg");
                        x: parent.width - 18px;
                        y: (parent.height - self.height) / 2;
                        width: 10px;
                        height: 10px;
                        colorize: root.dark_theme ? #e2e8f0 : #334155;
                        opacity: preset-control.available ? 1 : 0.38;
                    }
                }
            }
            Slider {
                minimum: 8;
                maximum: 72;
                step: 1;
                value: root.font_size / 1px;
                min-width: 60px;
                preferred-width: 160px;
                max-width: 160px;
                accessible-label: "Font size";
                changed(value) => {
                    root.font_size = value * 1px;
                    root.font-size-changed(value);
                }
            }
            Text {
                text: round(root.font_size / 1px);
                width: 22px;
                color: root.dark_theme ? #f8fafc : #1e293b;
                font-family: "Yu Gothic UI";
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Button {
                text: "×";
                width: 32px;
                height: 28px;
                accessible-label: "Close";
                clicked => { root.close-clicked(); }
            }
        }
    }
}
