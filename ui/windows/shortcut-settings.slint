// Editable OCR and capture-toolbar keyboard shortcuts.

import { Button, CheckBox, ComboBox, ScrollView, Palette } from "std-widgets.slint";

component ToolbarShortcutRow inherits Rectangle {
    in property <bool> dark_theme;
    in property <[string]> action_options;
    in property <[string]> key_options;
    in property <string> row_title;
    in-out property <int> action_index;
    in-out property <bool> win;
    in-out property <bool> alt;
    in-out property <bool> ctrl;
    in-out property <bool> shift;
    in-out property <int> key_index;

    background: dark_theme ? #37373f : #ffffff;
    border-radius: 10px;
    border-width: 1px;
    border-color: dark_theme ? transparent : #e2e8f0;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Text { text: row_title; font-weight: 700; color: dark_theme ? #e2e8f0 : #1e293b; font-size: 12px; }
        HorizontalLayout {
            spacing: 6px;
            Text { text: "Action:"; vertical-alignment: center; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
            ComboBox { model: action_options; current-index <=> action_index; }
        }
        HorizontalLayout {
            spacing: 2px;
            CheckBox { checked <=> win; text: "Win"; }
            CheckBox { checked <=> alt; text: "Alt"; }
            CheckBox { checked <=> ctrl; text: "Ctrl"; }
            CheckBox { checked <=> shift; text: "Shift"; }
        }
        HorizontalLayout {
            spacing: 6px;
            Text { text: "Key:"; vertical-alignment: center; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
            ComboBox { model: key_options; current-index <=> key_index; }
            Button {
                text: "Clear";
                clicked => {
                    action_index = 0;
                    win = false;
                    alt = false;
                    ctrl = false;
                    shift = false;
                    key_index = -1;
                }
            }
        }
    }
}

// Select area, Start, Restore/hide last mode, and seven capture-toolbar shortcuts are editable.
// The toolbar slots also pick the capture/record/OCR action they trigger.
export component ShortcutSettingsWindow inherits Window {
    title: "Shortcut settings";
    icon: @image-url("../../app.ico");
    preferred-width: 470px;
    preferred-height: 850px;
    min-width: 470px;
    min-height: 850px;
    max-width: 470px;
    max-height: 850px;
    background: dark_theme ? #2b2b31 : @linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    default-font-family: "Yu Gothic UI";

    in-out property <bool> dark_theme: false;

    // Filled from Rust so the combo-box indices match the stored bindings.
    in property <[string]> key_options: [];
    in property <[string]> action_options: [];

    in-out property <bool> select_win: true;
    in-out property <bool> select_alt: true;
    in-out property <bool> select_ctrl: false;
    in-out property <bool> select_shift: false;
    in-out property <int> select_key_index: 0;

    in-out property <bool> start_win: true;
    in-out property <bool> start_alt: true;
    in-out property <bool> start_ctrl: false;
    in-out property <bool> start_shift: false;
    in-out property <int> start_key_index: 15;

    in-out property <bool> restore_win: false;
    in-out property <bool> restore_alt: false;
    in-out property <bool> restore_ctrl: false;
    in-out property <bool> restore_shift: false;
    in-out property <int> restore_key_index: -1;

    in-out property <int> tool1_action_index: 0;
    in-out property <bool> tool1_win: false;
    in-out property <bool> tool1_alt: true;
    in-out property <bool> tool1_ctrl: false;
    in-out property <bool> tool1_shift: false;
    in-out property <int> tool1_key_index: -1;

    in-out property <int> tool2_action_index: 0;
    in-out property <bool> tool2_win: false;
    in-out property <bool> tool2_alt: true;
    in-out property <bool> tool2_ctrl: false;
    in-out property <bool> tool2_shift: false;
    in-out property <int> tool2_key_index: -1;

    in-out property <int> tool3_action_index: 0;
    in-out property <bool> tool3_win: false;
    in-out property <bool> tool3_alt: true;
    in-out property <bool> tool3_ctrl: false;
    in-out property <bool> tool3_shift: false;
    in-out property <int> tool3_key_index: -1;

    in-out property <int> tool4_action_index: 0;
    in-out property <bool> tool4_win: false;
    in-out property <bool> tool4_alt: true;
    in-out property <bool> tool4_ctrl: false;
    in-out property <bool> tool4_shift: false;
    in-out property <int> tool4_key_index: -1;

    in-out property <int> tool5_action_index: 0;
    in-out property <bool> tool5_win: false;
    in-out property <bool> tool5_alt: true;
    in-out property <bool> tool5_ctrl: false;
    in-out property <bool> tool5_shift: false;
    in-out property <int> tool5_key_index: -1;

    in-out property <int> tool6_action_index: 0;
    in-out property <bool> tool6_win: false;
    in-out property <bool> tool6_alt: true;
    in-out property <bool> tool6_ctrl: false;
    in-out property <bool> tool6_shift: false;
    in-out property <int> tool6_key_index: -1;

    in-out property <int> tool7_action_index: 0;
    in-out property <bool> tool7_win: false;
    in-out property <bool> tool7_alt: true;
    in-out property <bool> tool7_ctrl: false;
    in-out property <bool> tool7_shift: false;
    in-out property <int> tool7_key_index: -1;

    in-out property <string> status_text: "";
    in-out property <bool> status_error: false;

    callback save_clicked();
    callback close_clicked();

    init => {
        Palette.color-scheme = dark_theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark_theme => {
        Palette.color-scheme = dark_theme ? ColorScheme.dark : ColorScheme.light;
    }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: "SHORTCUT SETTINGS";
            font-weight: 700;
            color: dark_theme ? #45b8ed : #2563eb;
            font-size: 14px;
        }

        Text {
            text: "Pick Win / Alt / Ctrl / Shift plus a key, then press Save. Clear any shortcut to disable it, then Save.";
            color: dark_theme ? #94a3b8 : #64748b;
            font-size: 11px;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            content-height: max(self.visible-height, shortcut-content.preferred-height);
            shortcut-content := VerticalLayout {
                width: parent.width;
                spacing: 8px;
                alignment: start;
                // Select area
                Rectangle {
                    background: dark_theme ? #37373f : #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: dark_theme ? transparent : #e2e8f0;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "Select area"; font-weight: 700; color: dark_theme ? #e2e8f0 : #1e293b; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 2px;
                            CheckBox { checked <=> select_win; text: "Win"; }
                            CheckBox { checked <=> select_alt; text: "Alt"; }
                            CheckBox { checked <=> select_ctrl; text: "Ctrl"; }
                            CheckBox { checked <=> select_shift; text: "Shift"; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Key:"; vertical-alignment: center; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                            ComboBox { model: key_options; current-index <=> select_key_index; }
                            Button {
                                text: "Clear";
                                clicked => {
                                    select_win = false;
                                    select_alt = false;
                                    select_ctrl = false;
                                    select_shift = false;
                                    select_key_index = -1;
                                }
                            }
                        }
                    }
                }

                // Start / stop continuous OCR
                Rectangle {
                    background: dark_theme ? #37373f : #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: dark_theme ? transparent : #e2e8f0;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "Start"; font-weight: 700; color: dark_theme ? #e2e8f0 : #1e293b; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 2px;
                            CheckBox { checked <=> start_win; text: "Win"; }
                            CheckBox { checked <=> start_alt; text: "Alt"; }
                            CheckBox { checked <=> start_ctrl; text: "Ctrl"; }
                            CheckBox { checked <=> start_shift; text: "Shift"; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Key:"; vertical-alignment: center; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                            ComboBox { model: key_options; current-index <=> start_key_index; }
                            Button {
                                text: "Clear";
                                clicked => {
                                    start_win = false;
                                    start_alt = false;
                                    start_ctrl = false;
                                    start_shift = false;
                                    start_key_index = -1;
                                }
                            }
                        }
                    }
                }

                // Restore or hide the last mode; restoration shares the tray activation path.
                Rectangle {
                    background: dark_theme ? #37373f : #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: dark_theme ? transparent : #e2e8f0;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "Restore/hide last mode"; font-weight: 700; color: dark_theme ? #e2e8f0 : #1e293b; font-size: 12px; }
                        Text { text: "Press again to hide the last mode. Clear to disable."; color: dark_theme ? #94a3b8 : #64748b; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 2px;
                            CheckBox { checked <=> restore_win; text: "Win"; }
                            CheckBox { checked <=> restore_alt; text: "Alt"; }
                            CheckBox { checked <=> restore_ctrl; text: "Ctrl"; }
                            CheckBox { checked <=> restore_shift; text: "Shift"; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Key:"; vertical-alignment: center; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                            ComboBox { model: key_options; current-index <=> restore_key_index; }
                            Button {
                                text: "Clear";
                                clicked => {
                                    restore_win = false;
                                    restore_alt = false;
                                    restore_ctrl = false;
                                    restore_shift = false;
                                    restore_key_index = -1;
                                }
                            }
                        }
                    }
                }

                ToolbarShortcutRow {
                    dark_theme: root.dark_theme;
                    action_options: root.action_options;
                    key_options: root.key_options;
                    row_title: "Capture toolbar shortcut 1";
                    action_index <=> tool1_action_index;
                    win <=> tool1_win;
                    alt <=> tool1_alt;
                    ctrl <=> tool1_ctrl;
                    shift <=> tool1_shift;
                    key_index <=> tool1_key_index;
                }

                ToolbarShortcutRow {
                    dark_theme: root.dark_theme;
                    action_options: root.action_options;
                    key_options: root.key_options;
                    row_title: "Capture toolbar shortcut 2";
                    action_index <=> tool2_action_index;
                    win <=> tool2_win;
                    alt <=> tool2_alt;
                    ctrl <=> tool2_ctrl;
                    shift <=> tool2_shift;
                    key_index <=> tool2_key_index;
                }

                ToolbarShortcutRow {
                    dark_theme: root.dark_theme;
                    action_options: root.action_options;
                    key_options: root.key_options;
                    row_title: "Capture toolbar shortcut 3";
                    action_index <=> tool3_action_index;
                    win <=> tool3_win;
                    alt <=> tool3_alt;
                    ctrl <=> tool3_ctrl;
                    shift <=> tool3_shift;
                    key_index <=> tool3_key_index;
                }

                ToolbarShortcutRow {
                    dark_theme: root.dark_theme;
                    action_options: root.action_options;
                    key_options: root.key_options;
                    row_title: "Capture toolbar shortcut 4";
                    action_index <=> tool4_action_index;
                    win <=> tool4_win;
                    alt <=> tool4_alt;
                    ctrl <=> tool4_ctrl;
                    shift <=> tool4_shift;
                    key_index <=> tool4_key_index;
                }

                ToolbarShortcutRow {
                    dark_theme: root.dark_theme;
                    action_options: root.action_options;
                    key_options: root.key_options;
                    row_title: "Capture toolbar shortcut 5";
                    action_index <=> tool5_action_index;
                    win <=> tool5_win;
                    alt <=> tool5_alt;
                    ctrl <=> tool5_ctrl;
                    shift <=> tool5_shift;
                    key_index <=> tool5_key_index;
                }

                ToolbarShortcutRow {
                    dark_theme: root.dark_theme;
                    action_options: root.action_options;
                    key_options: root.key_options;
                    row_title: "Capture toolbar shortcut 6";
                    action_index <=> tool6_action_index;
                    win <=> tool6_win;
                    alt <=> tool6_alt;
                    ctrl <=> tool6_ctrl;
                    shift <=> tool6_shift;
                    key_index <=> tool6_key_index;
                }

                ToolbarShortcutRow {
                    dark_theme: root.dark_theme;
                    action_options: root.action_options;
                    key_options: root.key_options;
                    row_title: "Capture toolbar shortcut 7";
                    action_index <=> tool7_action_index;
                    win <=> tool7_win;
                    alt <=> tool7_alt;
                    ctrl <=> tool7_ctrl;
                    shift <=> tool7_shift;
                    key_index <=> tool7_key_index;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button { text: "Save"; primary: true; width: 96px; height: 32px; clicked => { save_clicked(); } }
            Button { text: "Close"; width: 96px; height: 32px; clicked => { close_clicked(); } }
            Rectangle { } // Flexible spacer keeps the buttons on the left
        }

        Text {
            text: status_text;
            color: status_error ? #ef4444 : (dark_theme ? #4ade80 : #16a34a);
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
