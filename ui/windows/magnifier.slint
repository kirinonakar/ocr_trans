import { CheckBox, Slider, Palette } from "std-widgets.slint";
import { ToolbarButton } from "../components/toolbar-button.slint";

export component MagnifierWindow inherits Window {
    title: source_title + " — " + zoom_percent + "%";
    no-frame: true;
    always-on-top: true;
    resize-border-width: 9px;
    preferred-width: 720px;
    preferred-height: 450px;
    min-width: 600px;
    min-height: 190px;
    background: dark_theme ? #2b2b31 : #f8fafc;
    default-font-family: "Yu Gothic UI";

    in-out property <bool> dark_theme: false;
    in-out property <bool> source_available: false;
    in-out property <bool> capture_busy: false;
    in-out property <bool> recording: false;
    in-out property <bool> hide_titlebar: false;
    in-out property <bool> record_available: true;
    in-out property <string> source_title: "Window magnifier";
    in-out property <float> zoom_percent: 200;
    in-out property <float> max_zoom_percent: 400;
    in-out property <string> status_text: "";
    in-out property <string> preview_notice: "";
    in-out property <bool> quality_active: false;
    in-out property <bool> quality_exact: false;
    in-out property <image> quality_image;
    in-out property <float> quality_x;
    in-out property <float> quality_y;
    in-out property <float> quality_width;
    in-out property <float> quality_height;
    in-out property <bool> preview_cursor_visible: false;
    in-out property <float> preview_cursor_x;
    in-out property <float> preview_cursor_y;
    callback drag_requested();
    callback zoom_changed(float);
    callback hide_titlebar_changed();
    callback capture_clicked();
    callback record_clicked();
    callback close_clicked();
    callback status_changed(string);

    init => { Palette.color-scheme = dark_theme ? ColorScheme.dark : ColorScheme.light; }
    changed dark_theme => { Palette.color-scheme = dark_theme ? ColorScheme.dark : ColorScheme.light; }
    changed status_text => { if root.status_text != "" { root.status_changed(root.status_text); } }
    changed preview_notice => { root.status_changed(root.preview_notice); }

    Image {
        visible: root.quality_active;
        x: root.quality_x * 1px;
        y: root.quality_y * 1px;
        width: root.quality_width * 1px;
        height: root.quality_height * 1px;
        source: root.quality_image;
        image-fit: fill;
        // Keep this image/texture alive through zoom changes. Temporarily stretch
        // the last frame smoothly until the exact-size Lanczos result arrives.
        image-rendering: root.quality_exact ? pixelated : smooth;
    }

    Image {
        visible: root.preview_cursor_visible;
        x: root.preview_cursor_x * 1px;
        y: root.preview_cursor_y * 1px;
        width: 20px;
        height: 28px;
        source: @image-url("../icons/magnifier-cursor.svg");
    }

    // Match the capture frame's header. Explicit geometry keeps every control
    // together in the reserved strip above the DWM thumbnail.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 42px;
        background: root.dark_theme ? #2b2b31f5 : #f8fafcf5;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.dark_theme ? #52525b : #cbd5e1;
        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            padding-left: 7px;
            padding-right: 7px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 6px;
            ToolbarButton {
                icon: @image-url("../icons/drag.svg");
                dark_theme: root.dark_theme;
                width: 28px;
                height: 34px;
                available: !root.recording;
                press_on_down: true;
                pressed => { root.drag_requested(); }
            }
            Slider {
                minimum: 50;
                // Keep a nonzero visual range when only 50% fits; the slider
                // is disabled in that case and the selected value stays at 50%.
                maximum: max(51, root.max_zoom_percent);
                step: 1;
                value <=> root.zoom_percent;
                min-width: 60px;
                preferred-width: 160px;
                max-width: 160px;
                horizontal-stretch: 1;
                enabled: !root.recording && root.max_zoom_percent > 50;
                changed(value) => { root.zoom_changed(value); }
            }
            Text {
                text: root.zoom_percent + "%";
                width: 42px;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12px;
                color: root.dark_theme ? #f8fafc : #1e293b;
            }
            Rectangle { horizontal-stretch: 1; }
            CheckBox {
                text: "Hide titlebar";
                checked <=> root.hide_titlebar;
                enabled: !root.recording;
                toggled => { root.hide_titlebar_changed(); }
            }
            ToolbarButton {
                icon: @image-url("../icons/capture.svg");
                label: "Capture";
                dark_theme: root.dark_theme;
                width: 78px;
                height: 34px;
                available: root.source_available && !root.capture_busy;
                pressed => { root.capture_clicked(); }
            }
            ToolbarButton {
                icon: root.recording ? @image-url("../icons/stop.svg") : @image-url("../icons/record.svg");
                label: root.recording ? "Stop" : "Record";
                dark_theme: root.dark_theme;
                width: 74px;
                height: 34px;
                available: root.recording || (root.source_available && root.record_available);
                active: root.recording;
                pressed => { root.record_clicked(); }
            }
            ToolbarButton {
                icon: @image-url("../icons/close.svg");
                dark_theme: root.dark_theme;
                width: 30px;
                height: 34px;
                icon_size: 16px;
                pressed => { root.close_clicked(); }
            }
        }
    }
}
