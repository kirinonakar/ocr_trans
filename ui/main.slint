import { Button, CheckBox, SpinBox, Slider, GroupBox, LineEdit, ComboBox, TextEdit, ScrollView, Palette } from "std-widgets.slint";

component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <bool> available: true;
    in property <bool> active: false;
    in property <bool> dark_theme: false;
    in property <bool> press_on_down: false;
    in property <string> label: "";
    in property <string> tooltip: "";
    in property <length> icon_size: 17px;
    callback pressed();
    callback hovered_tooltip_changed(string);

    width: 30px;
    height: 30px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: 0px;
    border-color: transparent;
    background: active
        ? (dark_theme ? #45b8ed : #dbeafe)
        : (dark_theme ? (touch.has-hover ? #4a4a55 : #3a3a43) : (touch.has-hover ? #e2e8f0 : #ffffffcc));
    opacity: available ? 1.0 : 0.38;

    Image {
        source: icon;
        width: label == "" ? icon_size : 14px;
        height: label == "" ? icon_size : 14px;
        x: label == "" ? (parent.width - self.width) / 2 : 6px;
        y: (parent.height - self.height) / 2;
        colorize: dark_theme ? #e2e8f0 : #334155;
    }

    if (label != "") : Text {
        x: 24px;
        width: parent.width - 27px;
        height: parent.height;
        text: label;
        color: dark_theme ? #f8fafc : #1e293b;
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        z: 10;
        // A press-on-down control starts a native drag loop. That loop consumes the native
        // mouse-up event, so let Slint cancel and release its TouchArea grab immediately after
        // the press. Otherwise the move button keeps intercepting every later toolbar click.
        enabled: available && !(press_on_down && touch.pressed);
        pointer-event(event) => {
            if (press_on_down && event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                pressed();
            }
        }
        changed has-hover => {
            if (tooltip != "") {
                hovered_tooltip_changed(self.has-hover ? tooltip : "");
            }
        }
        clicked => {
            if (!press_on_down) { pressed(); }
        }
    }
}

component FrameResizeHandle inherits TouchArea {
    in property <string> direction;
    callback resize_requested(string);

    // A native resize loop consumes the mouse release, so cancel Slint's pointer grab as soon
    // as the resize begins. This mirrors the toolbar's native drag handle behavior.
    enabled: !self.pressed;
    pointer-event(event) => {
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
            resize_requested(direction);
        }
    }
}

export component MainWindow inherits Window {
    title: "OCR Translator";
    icon: @image-url("../app.ico");
    width: 400px;
    // Keep each OCR layout state fixed while giving the optional style panel its own height.
    // The closed state is shorter to avoid unused space; the open state has room for all controls.
    preferred-height: show_style_settings ? 990px : 870px;
    min-height: show_style_settings ? 990px : 870px;
    max-height: show_style_settings ? 990px : 870px;
    background: dark_theme
        ? #2b2b31
        : @linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    default-font-family: "Yu Gothic UI";

    // Keep std-widgets (LineEdit, TextEdit, ComboBox, etc.) on the same palette as the
    // application theme. Without this, the widgets follow the OS palette independently and
    // can remain light while the OCR window is dark.
    init => {
        Palette.color-scheme = dark_theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark_theme => {
        Palette.color-scheme = dark_theme ? ColorScheme.dark : ColorScheme.light;
    }

    in-out property <bool> is_running: false;
    in-out property <string> api_type: "LMStudio";
    in-out property <int> api_type_index: 0;
    in property <[string]> provider_options: ["LMStudio", "Google Gemini", "Cerebras", "Ollama", "Ollama Cloud", "Unsloth Desktop", "OpenCode Go", "OpenCode Zen"];
    in-out property <string> api_endpoint: "http://localhost:1234/v1";
    in-out property <string> api_key: "";
    in-out property <string> model_name: "google/gemma-4-26b-a4b";
    in property <[string]> model_options: ["google/gemma-4-26b-a4b", "qwen/qwen3.5-9b"];
    in-out property <int> model_index: 0;
    in-out property <float> interval: 0;
    in-out property <bool> overlay_visible: true;
    in-out property <string> system_prompt: "naturally translate into korean. only show translated texts.";
    in-out property <float> base_font_size: 16;
    in-out property <float> temperature: 0.7;
    in-out property <string> thinking_level: "default";
    in property <[string]> thinking_level_options: ["default", "disable", "low", "medium", "high", "xhigh", "max"];
    in-out property <color> overlay_bg_color: #ffffff;
    in-out property <color> overlay_text_color: #1e293b;
    in-out property <float> overlay_bg_opacity: 0.9;
    in-out property <bool> show_style_settings: false;
    in-out property <bool> dark_theme: false;
    in-out property <bool> use_textbox: false;
    in-out property <string> last_translated_text: "";
    in-out property <string> app_mode: "ocr";
    in-out property <string> capture_folder: "";

    
    
    callback start_stop_clicked();
    callback select_area_clicked();
    callback api_type_changed(string);
    callback api_key_changed(string);
    callback overlay_toggle_clicked(bool);
    callback refresh_models_clicked();
    callback sync_lmstudio_models();
    callback style_panel_toggled(bool);
    callback style_changed();
    callback folder_select_clicked();
    callback capture_folder_changed(string);
    callback system_prompt_changed(string);

    callback model_changed(string);
    callback thinking_level_changed(string);
    callback theme_toggle_clicked();
    callback mode_toggle_clicked(string);
    VerticalLayout {
        alignment: start;
        padding: 14px;
        padding-bottom: 30px; // Increased bottom padding to lift content
        spacing: 10px;

        HorizontalLayout {
            height: 30px;
            spacing: 8px;

            Image {
                source: @image-url("../app.ico");
                width: 26px;
                height: 26px;
            }

            Text {
                text: "OCR Translator";
                font-size: 18px;
                color: dark_theme ? #45b8ed : #2563eb;
                vertical-alignment: center;
                font-weight: 800;
            }

            Rectangle { }

            // Keep the theme action immediately to the left of the mode switch.
            ToolbarButton {
                icon: @image-url("icons/theme.svg");
                dark_theme: dark_theme;
                active: dark_theme;
                width: 30px;
                icon_size: 16px;
                pressed => { theme_toggle_clicked(); }
            }

            // OCR mode exposes a plain Capture button; the old switch's white knob is not needed.
            ToolbarButton {
                icon: @image-url("icons/ui.svg");
                dark_theme: dark_theme;
                active: app_mode == "capture";
                width: 78px;
                icon_size: 15px;
                label: app_mode == "capture" ? "OCR" : "Capture";
                pressed => {
                    mode_toggle_clicked(app_mode == "capture" ? "ocr" : "capture");
                }
            }
        }

        Rectangle {
            background: dark_theme ? #37373f : #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: dark_theme ? transparent : #e2e8f0;
            
            VerticalLayout {
                spacing: 8px;
                padding: 10px;
                Text { text: "API SETTINGS"; font-weight: 700; color: dark_theme ? #45b8ed : #2563eb; font-size: 14px; }
                
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Provider:"; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                    ComboBox {
                        model: provider_options;
                        current-value <=> api_type;
                        current-index <=> api_type_index;
                        selected(value) => {
                            api_type_changed(value);
                            if (value == "LMStudio" || value == "Ollama" || value == "Ollama Cloud" || value == "Unsloth Desktop" || value == "OpenCode Go" || value == "OpenCode Zen") { sync_lmstudio_models(); }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Endpoint:"; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                    LineEdit {
                        text <=> api_endpoint;
                        placeholder-text: "http://localhost:1234/v1";
                    }
                }
                
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "API Key:"; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                    LineEdit {
                        text <=> api_key;
                        input-type: password;
                        placeholder-text: "Leave empty for local providers";
                        edited(value) => { api_key_changed(value); }
                        accepted(value) => { api_key_changed(value); }
                    }
                }
                
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Model Name:"; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 6px;
                        ComboBox {
                            model: model_options;
                            current-value <=> model_name;
                            current-index <=> model_index;
                            selected(value) => { model_changed(value); }
                        }
                        ToolbarButton {
                            icon: @image-url("icons/sync.svg");
                            dark_theme: dark_theme;
                            width: 32px;
                            height: 32px;
                            icon_size: 18px;
                            pressed => { refresh_models_clicked(); }
                        }
                    }
                }
                
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Temperature:"; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                        Text { text: round(temperature * 10) / 10; color: dark_theme ? #e2e8f0 : #1e293b; font-size: 12px; font-weight: 700; }
                        Rectangle { } // Flexible spacer to push content left
                    }
                    Slider {
                        minimum: 0.0;
                        maximum: 1.0;
                        value <=> temperature;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Thinking Level:"; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                    ComboBox {
                        model: thinking_level_options;
                        current-value <=> thinking_level;
                        selected(value) => { thinking_level_changed(value); }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "System Prompt:"; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                    Rectangle {
                        background: dark_theme ? #2b2b31 : #f8fafc;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: dark_theme ? transparent : #e2e8f0;
                        height: 80px;
                        TextEdit {
                            text <=> system_prompt;
                            width: 100%;
                            height: 100%;
                            font-size: 13px;
                            edited(value) => { system_prompt_changed(value); }
                        }
                    }
                }
            }
        }

        Rectangle {
            background: dark_theme ? #37373f : #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: dark_theme ? transparent : #e2e8f0;
            
            VerticalLayout {
                spacing: 8px;
                padding: 10px;
                Text { text: "CAPTURE SETTINGS"; font-weight: 700; color: dark_theme ? #45b8ed : #2563eb; font-size: 14px; }
                
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: "Interval (s): "; vertical-alignment: center; color: dark_theme ? #cbd5e1 : #64748b; }
                    Text { text: interval == 0 ? "Once" : (round(interval * 10) / 10); vertical-alignment: center; font-weight: 700; color: dark_theme ? #e2e8f0 : #1e293b; }
                    Rectangle { } // Flexible spacer to push content left
                }
                Slider {
                    minimum: 0;
                    maximum: 10;
                    value: interval;
                    changed(val) => {
                        if (val < 0.25) {
                            interval = 0;
                        } else {
                            interval = round(val * 2) / 2;
                        }
                    }
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Text {
                        text: "Save folder:";
                        width: 74px;
                        vertical-alignment: center;
                        color: dark_theme ? #cbd5e1 : #64748b;
                        font-size: 12px;
                    }
                    LineEdit {
                        text <=> capture_folder;
                        placeholder-text: "Pictures";
                        edited(value) => { capture_folder_changed(value); }
                        accepted(value) => { capture_folder_changed(value); }
                    }
                    Button {
                        text: "Browse";
                        width: 68px;
                        height: 28px;
                        primary: false;
                        clicked => { folder_select_clicked(); }
                    }
                }
                HorizontalLayout {
                    Text { text: "Font Size: "; vertical-alignment: center; color: dark_theme ? #cbd5e1 : #64748b; }
                    Text { text: round(base_font_size); vertical-alignment: center; font-weight: 700; color: dark_theme ? #e2e8f0 : #1e293b; }
                    
                    Rectangle { } // Flexible spacer
                    
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Textbox"; vertical-alignment: center; color: dark_theme ? #cbd5e1 : #64748b; font-size: 12px; }
                        CheckBox { 
                            checked <=> use_textbox;
                            toggled => { style_changed(); }
                        }
                    }
                    
                    Rectangle { width: 8px; }
                    
                    Button {
                        text: show_style_settings ? "▲ Style" : "▼ Style";
                        height: 24px;
                        primary: false;
                        clicked => {
                            show_style_settings = !show_style_settings;
                            style_panel_toggled(show_style_settings);
                        }
                    }
                }
                Slider {
                    minimum: 8;
                    maximum: 72; // Increased max font size
                    value: base_font_size;
                    changed(val) => { base_font_size = val; style_changed(); }
                }

                if (show_style_settings) : VerticalLayout {
                    spacing: 8px;
                    padding-top: 4px;
                    padding-bottom: 8px;
                    
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Background:"; font-size: 11px; color: dark_theme ? #cbd5e1 : #64748b; }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { 
                                    background: #ffffff; 
                                    border-width: overlay_bg_color == #ffffff ? 2px : 1px; 
                                    border-color: overlay_bg_color == #ffffff ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_bg_color = #ffffff; style_changed(); } } 
                                }
                                Rectangle { 
                                    background: #000000; 
                                    border-width: overlay_bg_color == #000000 ? 2px : 1px; 
                                    border-color: overlay_bg_color == #000000 ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_bg_color = #000000; style_changed(); } } 
                                }
                                Rectangle { 
                                    background: #1e293b; 
                                    border-width: overlay_bg_color == #1e293b ? 2px : 1px; 
                                    border-color: overlay_bg_color == #1e293b ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_bg_color = #1e293b; style_changed(); } } 
                                }
                                Rectangle { 
                                    background: #fef08a; 
                                    border-width: overlay_bg_color == #fef08a ? 2px : 1px; 
                                    border-color: overlay_bg_color == #fef08a ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_bg_color = #fef08a; style_changed(); } } 
                                }
                                Rectangle { 
                                    background: #dcfce7; 
                                    border-width: overlay_bg_color == #dcfce7 ? 2px : 1px; 
                                    border-color: overlay_bg_color == #dcfce7 ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_bg_color = #dcfce7; style_changed(); } } 
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                Text { text: "Text Color:"; font-size: 11px; color: dark_theme ? #cbd5e1 : #64748b; vertical-alignment: center; }
                                Rectangle { } // Flexible spacer
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { 
                                    background: #1e293b; 
                                    border-width: overlay_text_color == #1e293b ? 2px : 1px; 
                                    border-color: overlay_text_color == #1e293b ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_text_color = #1e293b; style_changed(); } } 
                                }
                                Rectangle { 
                                    background: #ffffff; 
                                    border-width: overlay_text_color == #ffffff ? 2px : 1px; 
                                    border-color: overlay_text_color == #ffffff ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_text_color = #ffffff; style_changed(); } } 
                                }
                                Rectangle { 
                                    background: #ef4444; 
                                    border-width: overlay_text_color == #ef4444 ? 2px : 1px; 
                                    border-color: overlay_text_color == #ef4444 ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_text_color = #ef4444; style_changed(); } } 
                                }
                                Rectangle { 
                                    background: #2563eb; 
                                    border-width: overlay_text_color == #2563eb ? 2px : 1px; 
                                    border-color: overlay_text_color == #2563eb ? #2563eb : #e2e8f0; 
                                    width: 22px; height: 22px; border-radius: 4px; 
                                    TouchArea { clicked => { overlay_text_color = #2563eb; style_changed(); } } 
                                }
                            }
                        }
                    }

                    Text { text: "Background Opacity:"; font-size: 11px; color: dark_theme ? #cbd5e1 : #64748b; }
                    Slider {
                        minimum: 0.1;
                        maximum: 1.0;
                        value: overlay_bg_opacity;
                        changed(val) => { overlay_bg_opacity = val; style_changed(); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "SELECT AREA (Win + Alt + A)";
                        clicked => { select_area_clicked(); }
                    }
                    Rectangle {
                        background: dark_theme ? #2b2b31 : #f8fafc;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: dark_theme ? transparent : #e2e8f0;
                        height: 32px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text { text: "Overlay"; vertical-alignment: center; font-size: 12px; color: dark_theme ? #cbd5e1 : #64748b; }
                            CheckBox {
                                checked <=> overlay_visible;
                                toggled => { overlay_toggle_clicked(self.checked); }
                            }
                        }
                    }
                }
            }
        }


        VerticalLayout {
            spacing: 6px; // Keep the Idle marker clear of the bottom edge
            
            Button {
                text: is_running ? "STOP (Win+Alt+P)" : "START (Win+Alt+P)";
                height: 42px;
                primary: true;
                clicked => { start_stop_clicked(); }
            }

            Text {
                text: is_running ? "● Active" : "○ Idle";
                color: is_running ? #4caf50 : #94a3b8;
                horizontal-alignment: center;
                font-size: 12px;
            }
        }

        Rectangle { height: 10px; } // Extra spacer at the very bottom to lift it slightly more
    }
}

export component CaptureToolbarWindow inherits Window {
    title: "Capture & record";
    always-on-top: true;
    no-frame: true;
    background: transparent;
    default-font-family: "Yu Gothic UI";
    preferred-width: 603px;
    preferred-height: recording ? 48px : ((status_text == "" && active_tooltip == "") ? 48px : 68px);
    min-width: 603px;

    in-out property <bool> record_mode: false;
    in-out property <bool> frame_mode: false;
    in-out property <bool> recording: false;
    in-out property <bool> recording_paused: false;
    in-out property <bool> dark_theme: false;
    in-out property <string> recording_elapsed: "00:00";
    in-out property <string> status_text: "";
    in-out property <string> active_tooltip: "";
    in-out property <string> color_picker_tooltip: "Pick color";
    in-out property <string> ruler_tooltip: "Measure region";

    callback drag_requested();
    callback theme_toggle_clicked();
    callback ui_toggle_clicked();
    callback capture_mode_clicked();
    callback record_mode_clicked();
    callback fullscreen_clicked();
    callback window_clicked();
    callback scroll_clicked();
    callback frame_clicked();
    callback region_clicked();
    callback ocr_clicked();
    callback translate_clicked();
    callback vlm_clicked();
    callback color_picker_clicked();
    callback ruler_clicked();
    callback close_clicked();
    callback pause_recording_clicked();
    callback stop_recording_clicked();
    callback tooltip_visibility_changed(string);

    changed recording => {
        active_tooltip = "";
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        Rectangle {
            width: 100%;
            height: 48px;
            background: dark_theme ? #2b2b31f5 : #f1f5f9f5;
            border-radius: 9px;
            border-width: 0px;
            border-color: transparent;
            drop-shadow-color: dark_theme ? #00000080 : #00000030;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;

        if (!recording) : HorizontalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 48px;
            padding-left: 7px;
            padding-right: 7px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 5px;

            ToolbarButton {
                icon: @image-url("icons/drag.svg");
                dark_theme: dark_theme;
                width: 24px;
                height: 34px;
                tooltip: "Move toolbar";
                hovered_tooltip_changed(value) => {
                    active_tooltip = value;
                    tooltip_visibility_changed(value);
                }
                press_on_down: true;
                pressed => { drag_requested(); }
            }

            ToolbarButton {
                icon: @image-url("icons/theme.svg");
                dark_theme: dark_theme;
                active: dark_theme;
                width: 30px;
                height: 34px;
                icon_size: 16px;
                tooltip: "Toggle dark mode";
                hovered_tooltip_changed(value) => {
                    active_tooltip = value;
                    tooltip_visibility_changed(value);
                }
                pressed => { theme_toggle_clicked(); }
            }

            // This is the requested UI toggle immediately to the right of the theme button.
            ToolbarButton {
                icon: @image-url("icons/ui.svg");
                dark_theme: dark_theme;
                width: 64px;
                height: 34px;
                icon_size: 14px;
                label: "OCR";
                tooltip: "Return to OCR settings";
                hovered_tooltip_changed(value) => {
                    active_tooltip = value;
                    tooltip_visibility_changed(value);
                }
                pressed => { ui_toggle_clicked(); }
            }

            Rectangle {
                width: 68px;
                height: 34px;
                background: dark_theme ? #37373fff : #ffffffaa;
                border-radius: 7px;
                border-width: 0px;
                border-color: transparent;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 2px;
                    spacing: 3px;
                    ToolbarButton {
                        icon: @image-url("icons/capture.svg");
                        dark_theme: dark_theme;
                        active: !record_mode;
                        tooltip: "Capture mode";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { capture_mode_clicked(); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/record.svg");
                        dark_theme: dark_theme;
                        active: record_mode;
                        tooltip: "Record mode";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { record_mode_clicked(); }
                    }
                }
            }

            Rectangle {
                width: 167px;
                height: 34px;
                background: dark_theme ? #37373fff : #ffffffaa;
                border-radius: 7px;
                border-width: 0px;
                border-color: transparent;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 2px;
                    spacing: 3px;
                    ToolbarButton {
                        icon: @image-url("icons/fullscreen.svg");
                        dark_theme: dark_theme;
                        tooltip: "Capture full screen";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { fullscreen_clicked(); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/window.svg");
                        dark_theme: dark_theme;
                        tooltip: "Capture window";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { window_clicked(); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/scroll.svg");
                        dark_theme: dark_theme;
                        available: !record_mode;
                        tooltip: "Scrolling capture";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { scroll_clicked(); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/frame.svg");
                        dark_theme: dark_theme;
                        active: frame_mode;
                        tooltip: frame_mode ? "Close capture frame" : "Open capture frame";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { frame_clicked(); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/region.svg");
                        dark_theme: dark_theme;
                        tooltip: "Capture region";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { region_clicked(); }
                    }
                }
            }

            Rectangle {
                width: 104px;
                height: 34px;
                background: dark_theme ? #37373fff : #ffffffaa;
                border-radius: 7px;
                border-width: 0px;
                border-color: transparent;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 2px;
                    spacing: 3px;
                    ToolbarButton {
                        icon: @image-url("icons/ocr.svg");
                        dark_theme: dark_theme;
                        width: 30px;
                        tooltip: "OCR selected area";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { ocr_clicked(); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/translate.svg");
                        dark_theme: dark_theme;
                        width: 34px;
                        tooltip: "OCR and translate";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { translate_clicked(); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/vlm.svg");
                        dark_theme: dark_theme;
                        width: 30px;
                        tooltip: "Vision model capture";
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { vlm_clicked(); }
                    }
                }
            }

            // Keep the utility tools together, with a little extra separation from OCR/VLM.
            Rectangle {
                width: 67px;
                height: 34px;
                background: dark_theme ? #37373fff : #ffffffaa;
                border-radius: 7px;
                border-width: 0px;
                border-color: transparent;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 2px;
                    spacing: 3px;
                    ToolbarButton {
                        icon: @image-url("icons/color.svg");
                        dark_theme: dark_theme;
                        tooltip: color_picker_tooltip;
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { color_picker_clicked(); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/ruler.svg");
                        dark_theme: dark_theme;
                        tooltip: ruler_tooltip;
                        hovered_tooltip_changed(value) => {
                            active_tooltip = value;
                            tooltip_visibility_changed(value);
                        }
                        pressed => { ruler_clicked(); }
                    }
                }
            }

            ToolbarButton {
                icon: @image-url("icons/close.svg");
                dark_theme: dark_theme;
                height: 34px;
                icon_size: 16px;
                tooltip: "Exit application";
                hovered_tooltip_changed(value) => {
                    active_tooltip = value;
                    tooltip_visibility_changed(value);
                }
                pressed => { close_clicked(); }
            }
        }

        if (recording) : HorizontalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 48px;
            padding-left: 9px;
            padding-right: 9px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 8px;
            ToolbarButton {
                icon: @image-url("icons/drag.svg");
                dark_theme: dark_theme;
                width: 24px;
                tooltip: "Move toolbar";
                hovered_tooltip_changed(value) => {
                    active_tooltip = value;
                    tooltip_visibility_changed(value);
                }
                press_on_down: true;
                pressed => { drag_requested(); }
            }
            Rectangle {
                width: 12px;
                height: 34px;
                background: transparent;
                Rectangle {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #c42b1c;
                }
            }
            Text {
                text: recording_elapsed;
                font-family: "Consolas";
                font-size: 16px;
                font-weight: 650;
                color: dark_theme ? #f8fafc : #111827;
                vertical-alignment: center;
            }
            ToolbarButton {
                icon: recording_paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                dark_theme: dark_theme;
                width: 34px;
                tooltip: recording_paused ? "Resume recording" : "Pause recording";
                hovered_tooltip_changed(value) => {
                    active_tooltip = value;
                    tooltip_visibility_changed(value);
                }
                pressed => { pause_recording_clicked(); }
            }
            ToolbarButton {
                icon: @image-url("icons/stop.svg");
                dark_theme: dark_theme;
                active: true;
                width: 38px;
                tooltip: "Stop recording";
                hovered_tooltip_changed(value) => {
                    active_tooltip = value;
                    tooltip_visibility_changed(value);
                }
                pressed => { stop_recording_clicked(); }
            }
            }
        }

        if (!recording && active_tooltip != "") : Rectangle {
            width: 100%;
            height: 20px;
            background: dark_theme ? #2b2b31f5 : #ffffffee;
            border-width: 0px;
            border-color: transparent;
            drop-shadow-color: dark_theme ? #00000080 : #00000030;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            Text {
                width: 100%;
                height: 100%;
                text: active_tooltip;
                color: dark_theme ? #e2e8f0 : #334155;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if (!recording && active_tooltip == "" && status_text != "") : Text {
            width: 100%;
            height: 20px;
            text: status_text;
            color: dark_theme ? #cbd5e1 : #475569;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component CaptureFrameWindow inherits Window {
    title: "Capture frame";
    always-on-top: true;
    no-frame: true;
    background: transparent;
    default-font-family: "Yu Gothic UI";
    preferred-width: 720px;
    preferred-height: 450px;
    min-width: 300px;
    min-height: 190px;

    in-out property <bool> dark_theme: false;

    callback drag_requested();
    callback resize_requested(string);
    callback capture_clicked();
    callback record_clicked();
    callback close_clicked();

    // The opening starts at y=42px and 3px inside the remaining edges. Rust uses the same
    // measurements when translating this window into the physical screen capture rectangle.
    Rectangle {
        x: 0px;
        y: 39px;
        width: 100%;
        height: parent.height - 39px;
        background: transparent;
        border-width: 3px;
        border-color: dark_theme ? #45b8ed : #2563eb;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 42px;
        background: dark_theme ? #2b2b31f5 : #f8fafcf5;
        border-radius: 7px;
        border-width: 1px;
        border-color: dark_theme ? #52525b : #cbd5e1;
        drop-shadow-color: dark_theme ? #00000080 : #00000035;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;

        HorizontalLayout {
            padding-left: 7px;
            padding-right: 7px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 6px;

            ToolbarButton {
                icon: @image-url("icons/drag.svg");
                dark_theme: dark_theme;
                width: 28px;
                height: 34px;
                tooltip: "Move frame";
                press_on_down: true;
                pressed => { drag_requested(); }
            }

            Text {
                text: "FRAME";
                color: dark_theme ? #cbd5e1 : #475569;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ToolbarButton {
                icon: @image-url("icons/capture.svg");
                label: "Capture";
                dark_theme: dark_theme;
                width: 78px;
                height: 34px;
                pressed => { capture_clicked(); }
            }

            ToolbarButton {
                icon: @image-url("icons/record.svg");
                label: "Record";
                dark_theme: dark_theme;
                width: 74px;
                height: 34px;
                pressed => { record_clicked(); }
            }

            ToolbarButton {
                icon: @image-url("icons/close.svg");
                dark_theme: dark_theme;
                width: 30px;
                height: 34px;
                icon_size: 15px;
                pressed => { close_clicked(); }
            }
        }
    }

    // Generous invisible hit targets make every edge and corner easy to resize while keeping
    // the view through the frame completely clear.
    FrameResizeHandle {
        x: 0px; y: 0px; width: 10px; height: 10px; z: 30;
        direction: "north-west";
        resize_requested(direction) => { root.resize_requested(direction); }
    }
    FrameResizeHandle {
        x: parent.width - 10px; y: 0px; width: 10px; height: 10px; z: 30;
        direction: "north-east";
        resize_requested(direction) => { root.resize_requested(direction); }
    }
    FrameResizeHandle {
        x: 0px; y: parent.height - 10px; width: 10px; height: 10px; z: 30;
        direction: "south-west";
        resize_requested(direction) => { root.resize_requested(direction); }
    }
    FrameResizeHandle {
        x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; z: 30;
        direction: "south-east";
        resize_requested(direction) => { root.resize_requested(direction); }
    }
    FrameResizeHandle {
        x: 10px; y: 0px; width: parent.width - 20px; height: 6px; z: 29;
        direction: "north";
        resize_requested(direction) => { root.resize_requested(direction); }
    }
    FrameResizeHandle {
        x: 10px; y: parent.height - 6px; width: parent.width - 20px; height: 6px; z: 29;
        direction: "south";
        resize_requested(direction) => { root.resize_requested(direction); }
    }
    FrameResizeHandle {
        x: 0px; y: 10px; width: 6px; height: parent.height - 20px; z: 29;
        direction: "west";
        resize_requested(direction) => { root.resize_requested(direction); }
    }
    FrameResizeHandle {
        x: parent.width - 6px; y: 10px; width: 6px; height: parent.height - 20px; z: 29;
        direction: "east";
        resize_requested(direction) => { root.resize_requested(direction); }
    }
}

export component RecordingBorderWindow inherits Window {
    always-on-top: true;
    no-frame: true;
    background: transparent;
    in-out property <color> border_color: #ef4444;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: transparent;
        border-width: 2px;
        border-color: border_color;
    }
}

export component TextboxWindow inherits Window {
    title: "Result";
    icon: @image-url("../app.ico");
    always-on-top: true;
    preferred-width: 600px;
    preferred-height: 200px;
    min-width: 320px;
    min-height: 100px;
    background: dark_theme ? #2b2b31 : #f8fafc;
    default-font-family: "Yu Gothic UI";
    
    in-out property <string> text: "";
    in-out property <color> text_color: #1e293b;
    in-out property <length> font_size: 15px;
    in-out property <bool> dark_theme: false;

    VerticalLayout {
        padding: 12px;
        spacing: 0px; // Reduced spacing since header is removed
        Rectangle {
            background: dark_theme ? #37373f : #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: dark_theme ? #52525b : #e2e8f0;
            ScrollView {
                VerticalLayout {
                    width: parent.width;
                    padding: 8px;
                    TextInput {
                        text: text;
                        read-only: true;
                        font-size: font_size;
                        color: dark_theme
                            ? (text_color == #1e293b || text_color == #000000 ? #f8fafc : text_color)
                            : (text_color == #ffffff ? #1e293b : text_color);
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component OverlayWindow inherits Window {
    always-on-top: true;
    background: transparent;
    no-frame: true;
    icon: @image-url("../app.ico");
    default-font-family: "Yu Gothic UI";
    
    in-out property <length> window_x;
    in-out property <length> window_y;
    in-out property <length> window_w;
    in-out property <length> window_h;

    x: window_x;
    y: window_y;
    width: window_w;
    height: window_h;

    in-out property <string> translated_text: "";
    in-out property <bool> is_searching: false;
    in-out property <bool> show_text: false;
    in-out property <length> font_size: 16px;
    in-out property <color> bg_color: #ffffff;
    in-out property <color> text_color: #1e293b;
    in-out property <float> bg_opacity: 0.9;
    in-out property <bool> hide_text: false;
    in property <bool> is_textbox_mode: false;
    callback close_clicked();

    Rectangle {
        visible: show_text && translated_text != "";
        background: bg_color.with-alpha(bg_opacity);
        border-radius: 12px;
        border-width: 1px;
        border-color: bg_color.darker(0.2);
        
        // Close Button (X)
        Rectangle {
            visible: !is_textbox_mode;
            x: parent.width - 28px;
            y: 4px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: close_touch.has-hover ? #0000001a : #00000000;
            
            Text {
                text: "×";
                font-size: 20px;
                color: close_touch.has-hover ? #ef4444 : #64748b;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            close_touch := TouchArea {
                clicked => { close_clicked(); }
            }
        }
        
        VerticalLayout {
            visible: !hide_text;
            padding: 16px;
            padding-top: 24px; // Spacing for the close button
            Text {
                text: translated_text;
                color: text_color;
                font-size: font_size;
                wrap: word-wrap;
                horizontal-alignment: left;
                vertical-alignment: center; // Auto font-size handles fitting, center looks better
                font-weight: 500;
            }
        }
    }
}

export component SelectionWindow inherits Window {
    always-on-top: true;
    background: black;
    no-frame: true;
    icon: @image-url("../app.ico");
    default-font-family: "Yu Gothic UI";
    
    in-out property <image> screenshot;
    in-out property <bool> window_mode: false;
    in-out property <bool> color_picker_mode: false;
    in-out property <bool> ruler_mode: false;
    in-out property <length> hover_x: 0px;
    in-out property <length> hover_y: 0px;
    in-out property <length> hover_w: 0px;
    in-out property <length> hover_h: 0px;
    in-out property <color> color_preview: #000000;
    in-out property <string> color_hex: "";
    in-out property <string> color_decimal: "";
    in-out property <string> ruler_info_line_1: "";
    in-out property <string> ruler_info_line_2: "";
    in-out property <image> selection_magnifier;
    in-out property <bool> magnifier_visible: false;
    property <length> color_cursor_x: 0px;
    property <length> color_cursor_y: 0px;
    property <length> selection_cursor_x: 0px;
    property <length> selection_cursor_y: 0px;
    property <bool> selecting: false;
    property <length> start_x;
    property <length> start_y;
    property <length> current_x;
    property <length> current_y;
    
    // Optimized selection properties for stable calculation
    property <length> sel_x: start_x < current_x ? start_x : current_x;
    property <length> sel_y: start_y < current_y ? start_y : current_y;
    property <length> sel_w: abs_len(current_x - start_x);
    property <length> sel_h: abs_len(current_y - start_y);
    property <length> active_x: window_mode && hover_w > 0px ? hover_x : sel_x;
    property <length> active_y: window_mode && hover_h > 0px ? hover_y : sel_y;
    property <length> active_w: window_mode && hover_w > 0px ? hover_w : sel_w;
    property <length> active_h: window_mode && hover_h > 0px ? hover_h : sel_h;

    function abs_len(v: length) -> length {
        return v < 0px ? -v : v;
    }

    callback area_selected(length, length, length, length);
    callback window_hovered(length, length);
    callback window_selected(length, length);
    callback color_hovered(length, length);
    callback color_picked(length, length);
    callback selection_hovered(length, length);
    callback area_updated(length, length, length, length);
    callback closed();

    public function reset() {
        start_x = 0px;
        start_y = 0px;
        current_x = 0px;
        current_y = 0px;
        hover_x = 0px;
        hover_y = 0px;
        hover_w = 0px;
        hover_h = 0px;
        color_preview = #000000;
        color_hex = "";
        color_decimal = "";
        ruler_info_line_1 = "";
        ruler_info_line_2 = "";
        color_cursor_x = 0px;
        color_cursor_y = 0px;
        selection_cursor_x = 0px;
        selection_cursor_y = 0px;
        magnifier_visible = false;
        selecting = false;
    }

    // The base screenshot
    Image {
        source: screenshot;
        width: 100%;
        height: 100%;
    }

    // Dimmed background parts
    // Top
    Rectangle {
        x: 0; y: 0; width: parent.width;
        height: active_y;
        background: #00000080;
        visible: !color_picker_mode;
    }
    // Bottom
    Rectangle {
        x: 0; 
        y: active_y + active_h;
        width: parent.width;
        height: parent.height - self.y;
        background: #00000080;
        visible: !color_picker_mode;
    }
    // Left
    Rectangle {
        x: 0;
        y: active_y;
        width: active_x;
        height: active_h;
        background: #00000080;
        visible: !color_picker_mode;
    }
    // Right
    Rectangle {
        x: active_x + active_w;
        y: active_y;
        width: parent.width - self.x;
        height: active_h;
        background: #00000080;
        visible: !color_picker_mode;
    }
    
    // Always show a base dim when NOT selecting to avoid jump
    // Removed redundant Rectangle that caused flicker during transition

    i_touch := TouchArea {
        pointer-event(event) => {
            // TouchArea::moved is only emitted after a mouse grab. Handle move events here too
            // so the color preview is available before the first click/press.
            if (event.kind == PointerEventKind.move) {
                if (window_mode) {
                    window_hovered(i_touch.mouse-x, i_touch.mouse-y);
                } else if (color_picker_mode) {
                    color_cursor_x = i_touch.mouse-x;
                    color_cursor_y = i_touch.mouse-y;
                    color_hovered(color_cursor_x, color_cursor_y);
                } else {
                    selection_cursor_x = i_touch.mouse-x;
                    selection_cursor_y = i_touch.mouse-y;
                    if (!ruler_mode) {
                        selection_hovered(selection_cursor_x, selection_cursor_y);
                    }
                    if (selecting) {
                        current_x = selection_cursor_x;
                        current_y = selection_cursor_y;
                        if (ruler_mode) {
                            area_updated(sel_x, sel_y, sel_w, sel_h);
                        }
                    }
                }
            } else if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    selecting = true;
                    start_x = i_touch.mouse-x;
                    start_y = i_touch.mouse-y;
                    current_x = start_x;
                    current_y = start_y;
                    if (color_picker_mode) {
                        color_cursor_x = start_x;
                        color_cursor_y = start_y;
                        color_hovered(start_x, start_y);
                    } else if (ruler_mode) {
                        area_updated(sel_x, sel_y, sel_w, sel_h);
                    } else {
                        selection_cursor_x = start_x;
                        selection_cursor_y = start_y;
                        selection_hovered(selection_cursor_x, selection_cursor_y);
                    }
                } else if (event.kind == PointerEventKind.up) {
                    selecting = false;
                    if (color_picker_mode) {
                        color_cursor_x = i_touch.mouse-x;
                        color_cursor_y = i_touch.mouse-y;
                        color_hovered(color_cursor_x, color_cursor_y);
                        color_picked(color_cursor_x, color_cursor_y);
                    } else if (window_mode) {
                        window_selected(i_touch.mouse-x, i_touch.mouse-y);
                    } else {
                        // Provide the calculated rect.
                        area_selected(
                            start_x < current_x ? start_x : current_x,
                            start_y < current_y ? start_y : current_y,
                            abs_len(current_x - start_x),
                            abs_len(current_y - start_y)
                        );
                    }
                }
            }
        }
        changed has-hover => {
            if (color_picker_mode && self.has-hover) {
                color_cursor_x = i_touch.mouse-x;
                color_cursor_y = i_touch.mouse-y;
                color_hovered(color_cursor_x, color_cursor_y);
            } else if (!window_mode && !ruler_mode && self.has-hover) {
                selection_cursor_x = i_touch.mouse-x;
                selection_cursor_y = i_touch.mouse-y;
                selection_hovered(selection_cursor_x, selection_cursor_y);
            } else if (!self.has-hover) {
                magnifier_visible = false;
            }
        }
    }

    if (color_picker_mode && color_hex != "") : Rectangle {
        x: color_cursor_x + 18px + 244px > parent.width ? parent.width - 254px : color_cursor_x + 18px;
        y: color_cursor_y + 18px + 58px > parent.height ? color_cursor_y - 66px : color_cursor_y + 18px;
        width: 244px;
        height: 58px;
        z: 20;
        background: #020617e8;
        border-radius: 6px;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        Rectangle {
            x: 8px;
            y: 8px;
            width: 42px;
            height: 42px;
            background: color_preview;
            border-radius: 5px;
            border-width: 1px;
            border-color: #f8fafc;
        }
        Text {
            x: 62px;
            y: 7px;
            width: parent.width - 70px;
            height: 20px;
            text: "HEX: " + color_hex;
            color: #f8fafc;
            font-family: "Consolas";
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            x: 62px;
            y: 30px;
            width: parent.width - 70px;
            height: 20px;
            text: "DEC: " + color_decimal;
            color: #cbd5e1;
            font-family: "Consolas";
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    // A pixel-accurate 9x9 neighborhood for placing region corners precisely.
    if (!window_mode && !color_picker_mode && !ruler_mode && magnifier_visible) : Rectangle {
        x: selection_cursor_x + 18px + 120px > parent.width ? selection_cursor_x - 138px : selection_cursor_x + 18px;
        y: selection_cursor_y + 18px + 120px > parent.height ? selection_cursor_y - 138px : selection_cursor_y + 18px;
        width: 120px;
        height: 120px;
        z: 20;
        background: #020617e8;
        border-radius: 6px;
        border-width: 1px;
        border-color: #f8fafc;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;

        Image {
            x: 6px;
            y: 6px;
            width: 108px;
            height: 108px;
            source: selection_magnifier;
            image-fit: fill;
            image-rendering: pixelated;
        }

        // Grid lines separate the 81 source pixels; the outlined center is the cursor pixel.
        Rectangle { x: 18px; y: 6px; width: 1px; height: 108px; background: #ffffff55; }
        Rectangle { x: 30px; y: 6px; width: 1px; height: 108px; background: #ffffff55; }
        Rectangle { x: 42px; y: 6px; width: 1px; height: 108px; background: #ffffff55; }
        Rectangle { x: 54px; y: 6px; width: 1px; height: 108px; background: #ffffff55; }
        Rectangle { x: 66px; y: 6px; width: 1px; height: 108px; background: #ffffff55; }
        Rectangle { x: 78px; y: 6px; width: 1px; height: 108px; background: #ffffff55; }
        Rectangle { x: 90px; y: 6px; width: 1px; height: 108px; background: #ffffff55; }
        Rectangle { x: 102px; y: 6px; width: 1px; height: 108px; background: #ffffff55; }
        Rectangle { x: 6px; y: 18px; width: 108px; height: 1px; background: #ffffff55; }
        Rectangle { x: 6px; y: 30px; width: 108px; height: 1px; background: #ffffff55; }
        Rectangle { x: 6px; y: 42px; width: 108px; height: 1px; background: #ffffff55; }
        Rectangle { x: 6px; y: 54px; width: 108px; height: 1px; background: #ffffff55; }
        Rectangle { x: 6px; y: 66px; width: 108px; height: 1px; background: #ffffff55; }
        Rectangle { x: 6px; y: 78px; width: 108px; height: 1px; background: #ffffff55; }
        Rectangle { x: 6px; y: 90px; width: 108px; height: 1px; background: #ffffff55; }
        Rectangle { x: 6px; y: 102px; width: 108px; height: 1px; background: #ffffff55; }
        Rectangle {
            x: 54px;
            y: 54px;
            width: 12px;
            height: 12px;
            background: transparent;
            border-width: 2px;
            border-color: #facc15;
        }
    }

    if (ruler_mode && selecting && ruler_info_line_1 != "") : Rectangle {
        x: current_x + 18px + 390px > parent.width ? parent.width - 400px : current_x + 18px;
        y: current_y + 18px + 52px > parent.height ? current_y - 60px : current_y + 18px;
        width: 390px;
        height: 52px;
        z: 20;
        background: #020617e8;
        border-radius: 6px;
        border-width: 1px;
        border-color: #f59e0b;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        Text {
            x: 10px;
            y: 5px;
            width: parent.width - 20px;
            height: 20px;
            text: ruler_info_line_1;
            color: #f8fafc;
            font-family: "Consolas";
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            x: 10px;
            y: 27px;
            width: parent.width - 20px;
            height: 20px;
            text: ruler_info_line_2;
            color: #fde68a;
            font-family: "Consolas";
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                selecting = false;
                closed();
                return accept;
            }
            return reject;
        }
    }

    // Selection border
    Rectangle {
        x: active_x;
        y: active_y;
        width: active_w;
        height: active_h;
        border-color: window_mode ? #60cdff : (ruler_mode ? #f59e0b : #ffffff);
        border-width: (selecting || (window_mode && hover_w > 0px)) ? 2px : 0px; // Use border-width for smoother appearance
        background: transparent;
        visible: !color_picker_mode;
    }
    
    VerticalLayout {
        alignment: start;
        padding: 40px;
        Text {
            text: color_picker_mode ? "Click a pixel to copy its color" : (window_mode ? "Click a window to select it" : (ruler_mode ? "Drag to measure an area" : "Drag your mouse to select capture area"));
            color: white;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            opacity: color_picker_mode || selecting || (window_mode && hover_w > 0px) ? 0 : 1; // Use opacity for smoother transition
        }
    }
}
